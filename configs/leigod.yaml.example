# Leigod Isolated Network Namespace Configuration Example
# Copy to /etc/leigod/config.yaml or pass via --config

install_dir: /opt/leigod
state_dir: /var/lib/leigod
namespace: leigod-ns

# Virtual Ethernet pair between Host and Namespace
veth_host: leigod-host
veth_ns: eth0
host_veth_cidr: 10.254.254.1/24
ns_veth_cidr: 10.254.254.2/24

# Host policy routing table & rule preference to bypass Throne (Sing-box) TUN
route_table: 2540
rule_pref: 90
wan_interface: auto

# Persistent SteamDeck identity reported to Leigod mobile app
device_mac: auto
device_ip: auto

# Upstream asset mirror & ports
mirror_url: http://119.3.40.126
web_port: 5588
discovery_port: 6066

# Built-in game SOCKS5 server (supports TCP CONNECT + UDP ASSOCIATE)
socks5_listen: 127.0.0.1:15588
ns_socks5_listen: 10.254.254.2:1080

# Clean DNS servers used inside leigod-ns
dns_servers: 223.5.5.5, 119.29.29.29
skip_verify: false
